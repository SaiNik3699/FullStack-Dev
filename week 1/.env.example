# ---------------------------------------------------------------------------
# Copy this file to ".env" and adjust the values.
#   cp .env.example .env
#
# ".env" is listed in .gitignore so your real values never reach GitHub.
# Week 1 only needs PORT. The MongoDB line is here as a placeholder for Week 8.
# ---------------------------------------------------------------------------

# Port the Express server listens on
PORT=3000

# Week 8 preview - the connection string for MongoDB Atlas.
# Leave it commented out for now; nothing in Week 1 reads it.
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/week1
